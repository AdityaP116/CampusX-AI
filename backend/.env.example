# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,https://campusx-ai.onrender.com
ALLOWED_EMAIL_DOMAINS=nhitm.ac.in,edu,ac.in

# Firebase Admin SDK Configuration (From Firebase Console -> Project Settings -> Service accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Shared Redis Cache & Rate Limiting (Required for Multi-Instance Deployments)
# REDIS_URL=redis://default:password@your-redis-host:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Delivery Configuration (Choose Resend or SMTP for production student OTP dispatch)
RESEND_API_KEY=re_your_resend_api_key_here
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
SMTP_FROM=verify@campusx.ai
